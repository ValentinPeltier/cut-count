    "postcss": "^8.5.25",
    "fast-uri": "^3.1.4",
    "fast-xml-builder": "^1.1.6",
    "uuid": "^14.0.1",
    "js-yaml": "^4.3.0",
    "sharp": "0.35.4",
    "ws": "^8.21.0",
    "tmp": "^0.2.6",
    "systeminformation": "^5.31.7",
    "nanoid": "^3.3.18",
