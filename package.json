{
  "name": "bilan-carbone-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": []
  },
  "engines": {
    "node": "24.x",
    "yarn": "1.22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:bc": "turbo run dev --filter=bilan-carbone",
    "build": "turbo run build --filter=bilan-carbone",
    "test": "turbo run test",
    "start": "turbo run start",
    "ts": "turbo run ts",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prisma": "yarn workspace @abc-transitionbascarbone/db-common run prisma",
    "seed": "yarn seed:bc",
    "seed:bc": "yarn workspace bilan-carbone tsx prisma/seed/index.ts",
    "postinstall": "yarn db:generate",
    "db:generate": "rm -rf packages/db-common/src/generated/prisma && yarn workspace @abc-transitionbascarbone/db-common run db:generate",
    "compile:publicodes": "yarn workspace bilan-carbone publicodes-count:compile",
    "compile:publicodes-windows": "yarn workspace bilan-carbone publicodes-count:compile"
  },
  "dependencies": {
    "next": "16.3.3"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "resolutions": {
    "publicodes": "^1.10.1",
    "@publicodes/react-ui": "^1.10.0",
    "@hono/node-server": "^2.0.5",
    "@babel/core": "^7.29.6",
    "qs": "6.16.0",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.8",
    "hono": "^4.12.18",
    "postcss": "^8.5.25",
    "fast-uri": "^3.1.4",
    "fast-xml-builder": "^1.1.6",
    "uuid": "^14.0.1",
    "js-yaml": "^4.3.0",
    "sharp": "0.35.4",
    "ws": "^8.21.0",
    "tmp": "^0.2.6",
    "systeminformation": "^5.31.7",
    "nanoid": "^3.3.18",
    "vite": "^6.4.3",
    "mysql2": "^3.22.0",
    "deepmerge-ts": "^8.0.0"
  }
}
