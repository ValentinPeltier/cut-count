{
  "name": "count",
  "version": "2.7.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "26.x",
    "yarn": "1.22"
  },
  "scripts": {
    "postinstall": "yarn db:generate",
    "dev": "next dev",
    "with-test-env": "dotenv -e .env.test -e .env --",
    "prebuild": "yarn rules:compile",
    "build": "next build && node scripts/copy-assets.js",
    "start": "node -r dotenv/config .next/standalone/server.js dotenv_config_path=.env",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "test": "yarn test:unit && yarn test:rules && yarn test:e2e",
    "test:unit": "yarn with-test-env jest",
    "test:rules": "yarn rules:compile && cd src/publicodes/rules && vitest run --reporter=tree --config vitest.config.ts",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:gui": "bash scripts/e2e.sh --gui",
    "script": "dotenv -e .env -- tsx",
    "rules:compile": "cd src/publicodes/rules && publicodes compile",
    "rules:watch": "cd src/publicodes/rules && publicodes compile --watch",
    "rules:translate": "yarn rules:compile && yarn script scripts/i18n/generate-translation-file.tsx -m cut",
    "i18n:check": "node scripts/i18n/check-translations.mjs",
    "db": "prisma",
    "db:seed": "prisma db seed",
    "db:test:prepare": "yarn with-test-env prisma migrate deploy && yarn with-test-env tsx prisma/seed/index.ts",
    "db:generate": "rm -rf src/generated/prisma && prisma generate"
  },
  "prisma": {
    "seed": "dotenv -e .env -- env NODE_ENV=development tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@mui/x-charts": "^9.15.0",
    "@mui/x-date-pickers": "^9.15.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@publicodes/forms": "^0.6.1",
    "@sparticuz/chromium": "153.0.0",
    "@tanstack/react-table": "^9.2.6",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "big.js": "^7.0.1",
    "classnames": "^2.5.1",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "file-type": "^22.1.1",
    "fuse.js": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mui-color-input": "^9.0.0",
    "next": "16.4.0",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "node-xlsx": "^0.24.0",
    "nodemailer": "^10.0.16",
    "postcss": "^8.5.29",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-preset-env": "^11.6.1",
    "prisma": "^7.10.0",
    "publicodes": "^1.10.1",
    "puppeteer-core": "25.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@publicodes/tools": "^1.10.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/big.js": "^7.0.0",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
