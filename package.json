    "js-yaml": "^4.3.0",
    "ws": "^8.22.0",
    "tmp": "^0.2.6",
    "vite": "^8.3.3",
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.0"
  }
}