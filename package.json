{
  "name": "count",
  "version": "2.7.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "26.x",
    "yarn": "1.22"
  },
  "scripts": {
    "postinstall": "yarn db:generate",
    "dev": "next dev",
    "dev:test": "dotenv -e .env.test -e .env -- next dev --port 3001",
    "start:test": "dotenv -e .env.test -e .env -- env PORT=3001 node .next/standalone/server.js",
    "prebuild": "yarn rules:compile",
    "build": "next build && node scripts/copy-assets.js",
    "start": "node -r dotenv/config .next/standalone/server.js dotenv_config_path=.env",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "test": "yarn test:unit && yarn test:rules && yarn test:e2e",
    "test:unit": "dotenv -e .env.test -e .env -- jest",
    "test:unit:watch": "dotenv -e .env.test -e .env -- jest --watch",
    "test:rules": "yarn rules:compile && cd src/publicodes/rules && vitest run --reporter=tree --config vitest.config.ts",
    "test:e2e": "start-server-and-test 'yarn dev:test' http://127.0.0.1:3001 'yarn test:e2e:run'",
    "test:e2e:gui": "start-server-and-test 'yarn dev:test' http://127.0.0.1:3001 'yarn test:e2e:open'",
    "test:e2e:run": "dotenv -e .env.test -e .env -- cypress run",
    "test:e2e:open": "dotenv -e .env.test -e .env -- cypress open",
    "script": "dotenv -e .env -- tsx",
    "rules:compile": "cd src/publicodes/rules && publicodes compile",
    "rules:watch": "cd src/publicodes/rules && publicodes compile --watch",
    "rules:translate": "yarn rules:compile && yarn script scripts/i18n/generate-translation-file.tsx -m cut",
    "db": "prisma",
    "db:seed": "dotenv -e .env -- env NODE_ENV=development tsx prisma/seed/index.ts",
    "db:generate": "rm -rf src/generated/prisma && prisma generate",
    "db:test:reset": "dotenv -e .env.test -e .env -- prisma migrate reset --force && dotenv -e .env.test -e .env -- tsx prisma/seed/index.ts",
    "db:test:seed": "dotenv -e .env.test -e .env -- prisma migrate deploy && dotenv -e .env.test -e .env -- tsx prisma/seed/index.ts"
  },
  "prisma": {
    "seed": "dotenv -e .env -- env NODE_ENV=development tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-charts": "^8.29.3",
    "@mui/x-date-pickers": "^8.29.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@publicodes/forms": "^0.6.1",
    "@sparticuz/chromium": "149.0.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "big.js": "^7.0.1",
    "classnames": "^2.5.1",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "file-type": "^22.1.1",
    "fuse.js": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "mui-color-input": "^8.0.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.5",
    "node-xlsx": "^0.24.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^17.0.0",
    "postcss-nested": "^8.0.1",
    "postcss-preset-env": "^11.5.3",
    "prisma": "^7.10.0",
    "publicodes": "^1.10.1",
    "puppeteer-core": "25.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
