# Database (docker-compose: Postgres 5432)
POSTGRES_PRISMA_URL="postgresql://count:count@localhost:5432/count"

# Auth
NEXTAUTH_SECRET=<secret>
NEXTAUTH_URL=http://localhost:3000
ADMIN_PASSWORD=<pwd>

# Mail (local: docker-compose maildev on 1025)
MAIL_HOST=0.0.0.0
MAIL_PORT=1025
MAIL_USER=user@email.com
MAIL_PASSWORD=test

# Contact / support
CONTACT_EMAIL=contact@associationcount.fr
CONTACT_FORM_URL=https://abc-transitionbascarbone.fr/contact-et-hotline
NEXT_PUBLIC_CUT_SUPPORT_EMAIL=support@abc-transitionbascarbone.fr
NEXT_PUBLIC_CUT_FAQ_LINK=<faq_link>
NEXT_PUBLIC_CUT_ABC_SITE=https://abc-transitionbascarbone.fr/association-pour-la-transition-bas-carbone/
NEXT_PUBLIC_FORMATION_URL=https://abc-transitionbascarbone.fr/agir/se-former-au-bilan-carbone/
NEXT_PUBLIC_ACTORS_URL=https://abc-transitionbascarbone.fr/les-acteurs/annuaire-des-prestataires/

# PDF export
# Optional: base URL Chromium uses to load the preview page (defaults to the incoming request origin)
# PDF_RENDER_BASE_URL=http://127.0.0.1:3000
# Optional: override the Chromium binary (otherwise the npm-packaged one is used)
# PDF_CHROME_PATH=/usr/bin/chromium

# INSEE SIRET
INSEE_SERVICE_URL=https://api.insee.fr/api-sirene/3.11/siret/
INSEE_API_SECRET=<insee_api_secret>

# Emission-factor import versions pinned on Count studies
CUT_FE_SOURCES_IMPORT=BaseEmpreinte,Legifrance,CUT
CUT_FE_LEGIFRANCE_VERSION=<cut_fe_legifrance_version>
CUT_FE_BASE_EMPREINTE_VERSION=<cut_fe_base_empreinte_version>

# Crons
CRON_SECRET=<cron_secret>