{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",
    "types": ["cypress", "node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@abc-transitionbascarbone/css": ["../../packages/css/index.ts"]
    }
  },
  "ts-node": {
    "experimentalResolver": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "cypress/**/*.ts",
    "**/*.cy.ts",
    "prisma/**/*.ts",
    "../../packages/types/*",
    "../../packages/services/src/results/posts.enums.ts",
    "../../packages/tests/utils/models/translationsMock.tsx",
    "../../packages/utils/environmentClient.ts"
  ],
  "exclude": ["node_modules", "src/publicodes/rules/test"]
}
